# 心语时光 - 环境变量配置示例
# 复制本文件为 .env 并填写实际值

# ============== 核心配置 ==============

# Flask 密钥（必须修改！用于会话加密）
# 生成方法: python -c "import os; print(os.urandom(24).hex())"
SECRET_KEY=your-secret-key-change-this-in-production

# Flask 环境（development/production）
FLASK_ENV=production

# Flask 应用名称
FLASK_APP=wsgi.py

# ============== 数据库配置 ==============

# SQLite 数据库路径（默认）
DATABASE_URI=sqlite:////home/opc/rein-tini/instance/heartmoments.db

# 如需切换到 MySQL，使用以下格式：
# DATABASE_URI=mysql+pymysql://username:password@localhost:3306/heartmoments

# 如需切换到 PostgreSQL，使用以下格式：
# DATABASE_URI=postgresql://username:password@localhost:5432/heartmoments

# ============== 情侣信息 ==============

# 第一个人的名字
COUPLE_NAME_1=Rein

# 第二个人的名字
COUPLE_NAME_2=Tini

# 在一起的日期（格式：YYYY-MM-DD）
TOGETHER_DATE=2025-02-20

# 第一个纪念日名称（可选）
FIRST_ANNIVERSARY_NAME=相识纪念日

# 第一个纪念日日期（可选，格式：YYYY-MM-DD）
FIRST_ANNIVERSARY_DATE=2026-02-22

# ============== 文件上传配置 ==============

# 上传文件保存目录
UPLOAD_FOLDER=uploads

# 最大上传文件大小（字节，默认 5MB）
MAX_CONTENT_LENGTH=5242880

# 允许的图片格式（逗号分隔）
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,gif

# 缩略图宽度（像素）
THUMBNAIL_WIDTH=300

# 原图最大宽度（像素，超过会压缩）
MAX_IMAGE_WIDTH=1200

# JPEG 压缩质量（1-100，推荐 75）
JPEG_QUALITY=75

# ============== 分页配置 ==============

# 相册每页显示照片数
PHOTOS_PER_PAGE=20

# 日记列表每页显示数
POSTS_PER_PAGE=10

# 留言板每页显示数
MESSAGES_PER_PAGE=15

# ============== 安全配置 ==============

# 会话持续时间（天）
PERMANENT_SESSION_LIFETIME=7

# CSRF 保护（生产环境必须开启）
WTF_CSRF_ENABLED=True

# CSRF 密钥（可选，不填则使用 SECRET_KEY）
WTF_CSRF_SECRET_KEY=

# 登录失败最大尝试次数（速率限制）
MAX_LOGIN_ATTEMPTS=5

# 速率限制时间窗口（分钟）
RATE_LIMIT_WINDOW=15

# ============== 站点设置 ==============

# 网站标题
SITE_TITLE=心语时光

# 网站副标题
SITE_SUBTITLE=记录我们的美好瞬间

# 时区（Python pytz 格式）
TIMEZONE=Asia/Shanghai

# 默认语言
DEFAULT_LANGUAGE=zh_CN

# ============== 日志配置 ==============

# 日志级别（DEBUG/INFO/WARNING/ERROR/CRITICAL）
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/heartmoments.log

# 日志文件最大大小（字节，默认 10MB）
LOG_MAX_BYTES=10485760

# 日志文件备份数量
LOG_BACKUP_COUNT=5

# ============== 开发调试 ==============

# 开发模式（生产环境必须设为 False）
DEBUG=False

# 是否显示 SQL 查询（调试用）
SQLALCHEMY_ECHO=False

# ============== 备份配置 ==============

# 备份保存目录
BACKUP_DIR=backups

# 备份保留天数
BACKUP_RETENTION_DAYS=30

# ============== 功能开关 ==============

# 背景音乐功能（True/False）
# 音乐文件需要放在 app/static/music/ 目录
ENABLE_BACKGROUND_MUSIC=True

# 留言板功能（True/False）
ENABLE_MESSAGE_BOARD=True

# API 功能（True/False）
ENABLE_API=True

# 评论功能（True/False）
ENABLE_COMMENTS=True

